{
  "name": "han-thong",
  "version": "1.0.0",
  "description": "Từ điển Trung–Việt khi rê chuột: pinyin, chú âm, âm Hán-Việt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DucThanhNguyen/han-thong.git"
  },
  "keywords": [
    "Chinese",
    "Vietnamese",
    "Dictionary",
    "Hán Việt"
  ],
  "author": "Nguyễn Đức Thành",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/DucThanhNguyen/han-thong/issues"
  },
  "homepage": "https://github.com/DucThanhNguyen/han-thong#readme",
  "devDependencies": {
    "eslint": "^8.10.0",
    "stylelint": "^14.5.3",
    "stylelint-config-recommended": "^7.0.0",
    "@types/chrome": "^0.0.193"
  },
  "stylelint": {
    "extends": "stylelint-config-recommended"
  },
  "scripts": {
    "lint": "eslint --fix *.js js/options.js js/wordlist.js js/zhuyin.js",
    "csslint": "stylelint css/content.css css/wordlist.css",
    "build:dict": "node tools/build-dict.mjs",
    "build:font": "python3 tools/build-font.py",
    "package": "rm -f han-thong.zip && zip -r -X han-thong.zip manifest.json background.js content.js dict.js help.html options.html wordlist.html css js data fonts images -x 'images/*.svg' '*.DS_Store'"
  }
}
