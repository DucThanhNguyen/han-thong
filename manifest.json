{
  "manifest_version": 3,
  "name": "Hán Thông: Từ điển Trung–Việt",
  "short_name": "Hán Thông",
  "version": "1.0.0",
  "author": "Nguyễn Đức Thành",
  "homepage_url": "https://github.com/DucThanhNguyen/han-thong",
  "description": "Rê chuột lên chữ Hán để xem pinyin, chú âm, âm Hán-Việt và nghĩa tiếng Việt. Dựa trên Zhongwen của Christian Schiller.",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "24": "images/icon24.png",
      "32": "images/icon32.png"
    },
    "default_title": "Hán Thông – bật/tắt tra từ"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/config.js",
        "js/zhuyin.js",
        "content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/HanThongKai.woff2",
        "fonts/HanThongZhuyin.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "description": "Bật/tắt Hán Thông"
    }
  }
}
